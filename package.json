{
  "name": "knowledge-mcp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vp test run",
    "test:watch": "vp test",
    "typecheck": "tsc --noEmit",
    "d1:migrate": "wrangler d1 migrations apply knowledge-mcp --local",
    "d1:migrate:remote": "wrangler d1 migrations apply knowledge-mcp --remote",
    "eval": "node evals/run.ts",
    "prepare": "vp config"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.0",
    "@mozilla/readability": "^0.6.0",
    "fast-xml-parser": "^5.11.2",
    "linkedom": "^0.18.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@modelcontextprotocol/client": "^2.3.0",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "wrangler": "^4.146.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.0",
      "onFail": "download"
    }
  }
}
