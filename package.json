{
  "name": "knowledge-mcp",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "d1:migrate": "wrangler d1 migrations apply knowledge-mcp --local",
    "d1:migrate:remote": "wrangler d1 migrations apply knowledge-mcp --remote",
    "eval": "node evals/run.ts"
  },
  "packageManager": "pnpm@12.4.1",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@mozilla/readability": "^0.6.0",
    "fast-xml-parser": "^5.11.2",
    "linkedom": "^0.18.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0"
  }
}
